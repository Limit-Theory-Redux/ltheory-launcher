{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LTheoryReduxLauncher",
  "version": "0.6.1",
  "identifier": "LTheoryReduxLauncher",
  "build": {
    "beforeBuildCommand": "bun run generate",
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "visible": false,
        "fullscreen": false,
        "width": 1100,
        "height": 700,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "alwaysOnTop": false,
        "dragDropEnabled": false,
        "title": "LTR Launcher",
        "center": true,
        "focus": true,
        "label": "main",
        "decorations": false,
        "shadow": true,
        "closable": true,
        "minimizable": true
      }
    ],
"security": {
      "csp": "default-src 'none'; base-uri 'none'; object-src 'none'; frame-src 'none'; img-src 'self' asset: https://asset.localhost data:; media-src 'self' asset: https://asset.localhost; style-src 'self'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://github.com; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "IllustrisJack",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "assets/LTR_Icon.ico"
    ],
    "longDescription": "",
    "shortDescription": "",
    "targets": [
      "nsis"
    ],
    "windows": {
      "allowDowngrades": true,
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
"nsis": {
        "installMode": "currentUser",
        "headerImage": "./assets/installer_header.bmp",
        "languages": [
          "English"
        ]
      }
    }
  },
"plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Limit-Theory-Redux/ltheory-launcher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5Q0Q2RDgyQjgyQUZCRkYKUldULyt5cTRnbTNOYVVxb2FEVk9pa2dKWG12OFZpQkNZNG5aMFJVdHExRkI3dVhFWXRvdEhaa0oK"
    }
  }
}
